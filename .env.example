# SnapStudy Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# ── Firebase ───────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Gemini AI ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# gemini-1.5-flash for batch (region detection, card generation)
MODEL_BATCH=gemini-1.5-flash

# gemini-1.5-flash-8b for live/low-latency (remediation)
MODEL_LIVE=gemini-1.5-flash-8b

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3001

# ── Frontend ───────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api
