# SnapStudy Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# ── Firebase (Free Spark Plan: Auth + Firestore) ───────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Supabase (Auth, DB & Storage) ─────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Optional Free Image Storage (Cloudinary Unsigned Upload) ─────────────────
# If omitted, SnapStudy uses free zero-setup dataURL + Firestore storage automatically.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Gemini AI ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_API_KEY_DETECT=
GEMINI_API_KEY_GENERATE=
GEMINI_API_KEY_REMEDIATE=

# gemini-3.5-flash for primary tasks (region detection, card generation, ingest)
GEMINI_PRIMARY_MODEL=gemini-3.5-flash
MODEL_BATCH=gemini-3.5-flash

# gemini-3.5-flash-lite for live/low-latency tasks (remediation)
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
MODEL_LIVE=gemini-3.5-flash-lite

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3001

# ── Frontend ───────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api

# ── Supabase (Authentication & Storage) ─────────────────────────────────────
# Add your Supabase credentials here to switch authentication, database, and image storage to Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=